#!/usr/bin/env bash
# Follow journal logs of the Python Redis consumer.
# Starts empty; only new lines are printed until Ctrl-C.
#
#   corrai-python-consumer
#
# Usage:
#   bin/follow-python-consumer
#   bin/follow-python-consumer -n 200
#   bin/follow-python-consumer --since "1 hour ago"
#   bin/follow-python-consumer --no-follow
#
# Keeps following until Ctrl-C.

set -euo pipefail

UNIT=corrai-python-consumer
LINES=""
SINCE=""
FOLLOW=1

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -n|--lines)
      LINES="${2:?--lines requires a count}"
      shift 2
      ;;
    --since)
      SINCE="${2:?--since requires a time}"
      shift 2
      ;;
    --no-follow)
      FOLLOW=0
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -n "$LINES" ]] && ! [[ "$LINES" =~ ^[0-9]+$ ]]; then
  echo "--lines must be a non-negative integer" >&2
  exit 2
fi

if ! command -v journalctl >/dev/null 2>&1; then
  echo "journalctl is required to read the consumer service logs" >&2
  exit 1
fi

args=(-u "$UNIT" --no-hostname)
if [[ -n "$LINES" ]]; then
  args+=(-n "$LINES")
elif [[ "$FOLLOW" -eq 1 ]]; then
  args+=(-n 0)
else
  args+=(-n 50)
fi
if [[ -n "$SINCE" ]]; then
  args+=(--since "$SINCE")
fi
if [[ "$FOLLOW" -eq 1 ]]; then
  args+=(-f)
else
  args+=(--no-pager)
fi

clear
exec journalctl "${args[@]}"
